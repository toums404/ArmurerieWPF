<UserControl x:Class="ArmurerieWPF.Views.AssemblageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <!-- gauche recette -->
        <Border Grid.Column="0" Margin="0,0,20,0" Background="#F8F8F8" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="1. Arme à composer" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding ListeArmes}" DisplayMemberPath="Nom" SelectedItem="{Binding ArmeSelectionnee}" Margin="0,0,0,20" Padding="5"/>

                <TextBlock Text="2. Ajouter une pièce" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="Pièce :" Margin="0,0,0,2"/>
                <ComboBox ItemsSource="{Binding ListePieces}" DisplayMemberPath="Nom" SelectedItem="{Binding PieceSelectionnee}" Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Quantité requise :" Margin="0,0,0,2"/>
                <TextBox Text="{Binding QuantiteSaisie, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Padding="5"/>

                <Button Content="Ajouter au panier" Command="{Binding AjouterPanierCommand}" Background="#007BFF" Foreground="White" FontWeight="Bold" Padding="10"/>
            </StackPanel>
        </Border>

        <!-- droite : panier -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Panier de la recette" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding Panier}" AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="White" BorderBrush="#DDDDDD" BorderThickness="1" MinHeight="250">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pièce" Binding="{Binding NomPiece}" Width="*" />
                        <DataGridTextColumn Header="Quantité" Binding="{Binding Quantite}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <Button Grid.Row="1" Content="Valider l'assemblage définitif" Command="{Binding ValiderPanierCommand}" 
                    Background="#28A745" Foreground="White" FontSize="16" FontWeight="Bold" Padding="15" Margin="0,15,0,0"/>
        </Grid>
    </Grid>
</UserControl>