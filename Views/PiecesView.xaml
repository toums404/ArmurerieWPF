<UserControl x:Class="ArmurerieWPF.Views.PiecesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ArmurerieWPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- gauche : liste -->
        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Catalogue des Pièces" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
            <DataGrid ItemsSource="{Binding ListePieces}" AutoGenerateColumns="True" IsReadOnly="True" 
                      Background="White" RowBackground="#FAFAFA" AlternatingRowBackground="White"
                      BorderBrush="#DDDDDD" BorderThickness="1"/>
        </StackPanel>

        <!-- droite : formulaire  -->
        <Border Grid.Column="1" Background="#F8F8F8" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Ajouter une pièce" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="Nom de la pièce :" Margin="0,5,0,2"/>
                <TextBox Text="{Binding NouveauNom, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Description :" Margin="0,5,0,2"/>
                <TextBox Text="{Binding NouvelleDescription, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Fournisseur :" Margin="0,5,0,2" FontWeight="Bold"/>
                <!-- liste deroulante -->
                <ComboBox ItemsSource="{Binding ListeFournisseurs}" 
                          DisplayMemberPath="NomSociete" 
                          SelectedItem="{Binding FournisseurSelectionne}" 
                          Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Prix d'achat (€) :" Margin="0,5,0,2"/>
                <TextBox Text="{Binding NouveauPrix, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Quantité en stock :" Margin="0,5,0,2"/>
                <TextBox Text="{Binding NouvelleQuantite, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Seuil d'alerte :" Margin="0,5,0,2"/>
                <TextBox Text="{Binding NouveauSeuil, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,15"/>

                <Button Content="Enregistrer la pièce" Command="{Binding AjouterPieceCommand}" Background="#FF9800" Foreground="White" FontWeight="Bold" Padding="10"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
