<Window x:Class="ArmurerieWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ArmurerieWPF.Views"
        xmlns:viewmodels="clr-namespace:ArmurerieWPF.ViewModels"
        Title="Armurerie TomCorp" Height="700" Width="1200">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ArmesViewModel}">
            <views:ArmesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:FournisseursViewModel}">
            <views:FournisseursView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PiecesViewModel}">
            <views:PiecesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AssemblageViewModel}">
            <views:AssemblageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:NouvelleVenteViewModel}">
            <views:NouvelleVenteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CommandeFournisseurViewModel}">
            <views:CommandeFournisseurView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:FabricationViewModel}">
            <views:FabricationView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- gauche menu -->
        <Border Grid.Column="0" Background="#1E272E">
            <StackPanel Margin="0,30,0,0">

                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Padding" Value="20,10,0,10"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2C3E50"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>

                <Image Source="/Images/TomCorp.png" Height="80" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                <TextBlock Text="BASE DE DONNÉES" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold" Margin="20,0,0,10"/>

                <Button Content="Accueil" Command="{Binding NaviguerAccueilCommand}" />
                <Button Content="Gestion des Armes" Command="{Binding NaviguerArmesCommand}" />
                <Button Content="Gestion des Pièces" Command="{Binding NaviguerPiecesCommand}" />
                <Button Content="Fournisseurs" Command="{Binding NaviguerFournisseursCommand}" Margin="0,0,0,20"/>

                <TextBlock Text="OPÉRATIONS" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold" Margin="20,0,0,10"/>
                <Button Content="Créer une recette" Command="{Binding NaviguerAssemblageCommand}" />
                <Button Content="Fabrication / Assemblage" Command="{Binding NaviguerFabricationCommand}" />
                <Button Content="Nouvelle Vente" Command="{Binding NaviguerNouvelleVenteCommand}" />
                <Button Content="Commande Fournisseur" Command="{Binding NaviguerCommandeCommand}" />
            </StackPanel>
        </Border>

        <!-- droite content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="20">
        </ContentControl>
    </Grid>
</Window>